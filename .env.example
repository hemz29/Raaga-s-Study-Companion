# Browser build (safe to expose; it is only a light abuse guard, not a real secret)
VITE_REPORT_SHARED_SECRET=change-me

# Vercel serverless function only. Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.
RESEND_API_KEY=
PARENT_EMAIL=
REPORT_SHARED_SECRET=change-me
# Optional: a sender on a domain you verified in Resend. Defaults to Resend's test sender.
REPORT_FROM_EMAIL=
